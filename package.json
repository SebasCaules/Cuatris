{
  "name": "cuatris",
  "version": "1.0.0",
  "private": true,
  "description": "Planificador de cursada para Ingeniería en Informática del ITBA — versión standalone del planner de StudyVaults.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run datos",
    "dev": "next dev",
    "prebuild": "npm run datos",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run datos && tsc --noEmit",
    "datos": "node scripts/build-planner-data.mjs && node scripts/build-finales-flags-data.mjs && node scripts/build-mesas-finales-data.mjs",
    "carreras": "node scripts/build-carreras-data.mjs",
    "datos:validar": "node scripts/datos/validar.mjs",
    "datos:fmt": "node scripts/datos/validar.mjs --fmt",
    "datos:triage": "node scripts/datos/triage.mjs",
    "guardarrailes": "node scripts/datos/guardarrailes.mjs .github",
    "sync": "bash scripts/sync-desde-studyvaults.sh",
    "check:optimizador": "tsx scripts/optimizer-check/run.ts",
    "test:grafo": "node scripts/build-planner-data.mjs && node scripts/test-grafo-layout.mts && node scripts/test-grafo-model.mts && node scripts/test-grafo-viewport.mts",
    "test:datos": "node --test \"scripts/datos/test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@studyvaults/ui": "*",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
